# ============================================================
# Конфигурация бота инвентаризации — пример для .env
# ============================================================
# 1. Скопируйте этот файл в .env:    cp .env.example .env
# 2. Отредактируйте значения
# 3. Никогда не коммитьте .env в git!
# ============================================================

# --- Telegram Bot ---
# Получить токен у @BotFather в Telegram
BOT_TOKEN=123456789:AAHdAaBbCcDdEeFfGgHhIiJjKkLlMmNnOo

# Разрешённые пользователи (chat_id через запятую). Только они могут пользоваться ботом.
# Узнать свой chat_id можно у @userinfobot в Telegram.
ALLOWED_CHAT_IDS=123456789,987654321

# Администраторы (полный доступ к админ-меню). Подмножество ALLOWED_CHAT_IDS.
ADMIN_CHAT_IDS=123456789

# --- База данных ---
# Путь к SQLite-файлу. По умолчанию data/inventory.db (volume-mounted из docker-compose)
DB_PATH=data/inventory.db

# --- FSM storage (опционально) ---
# Если REDIS_URL задан — бот использует Redis для хранения состояний.
# Состояния переживают перезапуск бота.
# В docker-compose: REDIS_URL=redis://redis:6379/0
# Если не задан — MemoryStorage (данные в RAM, теряются при перезапуске).
# REDIS_URL=redis://redis:6379/0

# --- Прокси (опционально, если api.telegram.org заблокирован) ---
# HTTP/HTTPS-прокси — работает из коробки:
# PROXY_URL=http://proxy.example.com:8080
# SOCKS5-прокси (требует: pip install aiohttp-socks, уже в requirements.txt):
# SOCKS5_PROXY=socks5://user:password@1.2.3.4:1080

# --- Веб-панель (web_app.py) ---
# Пароль для входа в веб-панель. Если не задан — панель открыта (небезопасно!).
# Рекомендуется bcrypt-хэш. Сгенерировать: python web_app.py --hash-password
# Пример хэша: WEB_PANEL_PASSWORD=$2b$12$N5XkJrU9kZ4wL2eEa1iJRODe...
# Для совместимости работает plain text, но выводит warning в лог.
WEB_PANEL_PASSWORD=

# Хост и порт веб-панели. В docker-compose рекомендуем 0.0.0.0:5000.
WEB_PANEL_HOST=0.0.0.0
WEB_PANEL_PORT=5000

# Включить secure cookie + HSTS (если панель за HTTPS через Caddy/Nginx)
WEB_PANEL_FORCE_HTTPS=false
